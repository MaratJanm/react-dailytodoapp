    borderRadius: '8px',
  },
  checkboxLabel: {
    display: 'flex',
    alignItems: 'center',
    cursor: 'pointer',
    fontSize: '14px',
    color: '#555',
  },
  checkbox: {
    marginRight: '8px',
    width: '18px',
    height: '18px',
  },
  incrementWrapper: {
    display: 'flex',
    alignItems: 'center',
    gap: '10px',
    marginTop: '10px',
    fontSize: '14px',
    color: '#555',
  },
  incrementInput: {
    width: '70px',
    padding: '6px 10px',
    fontSize: '14px',
    border: '2px solid #e0e0e0',
    borderRadius: '6px',
    outline: 'none',
  },
  addButton: {
    width: '100%',
    marginTop: '12px',
    padding: '12px',
    fontSize: '16px',
    fontWeight: '600',
    backgroundColor: '#4CAF50',
    color: 'white',
    border: 'none',
    borderRadius: '8px',
    cursor: 'pointer',
    transition: 'background-color 0.2s',
  },
  taskList: {
    display: 'flex',
    flexDirection: 'column',
    gap: '10px',
  },
  emptyText: {
    textAlign: 'center',
    color: '#999',
    padding: '40px',
  },
  taskItem: {
    backgroundColor: '#fff',
    padding: '16px',
    borderRadius: '10px',
    boxShadow: '0 1px 4px rgba(0,0,0,0.08)',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'space-between',
    transition: 'all 0.2s',
  },
  taskCompleted: {
    backgroundColor: '#f9f9f9',
  },
  taskContent: {
    flex: 1,
    display: 'flex',
    alignItems: 'center',
    gap: '10px',
    cursor: 'pointer',
  },
  taskText: {
    fontSize: '16px',
    color: '#333',
    transition: 'all 0.2s',
  },
  taskTextCompleted: {
    textDecoration: 'line-through',
    color: '#999',
  },
  progressBadge: {
    marginLeft: '10px',
    fontSize: '12px',
    backgroundColor: '#e8f5e9',
    padding: '2px 6px',
    borderRadius: '12px',
    color: '#2e7d32',
  },
  checkmark: {
    marginLeft: '10px',
    fontSize: '18px',
    color: '#4CAF50',
  },
  taskActions: {
    display: 'flex',
    gap: '8px',
  },
  editButton: {
    padding: '6px 10px',
    backgroundColor: '#2196F3',
    color: 'white',
    border: 'none',
    borderRadius: '4px',
    cursor: 'pointer',
  },
  deleteButton: {
    padding: '6px 10px',
    backgroundColor: '#f44336',
    color: 'white',
    border: 'none',
    borderRadius: '4px',
    cursor: 'pointer',
  },
  editForm: {
    display: 'flex',
    flexDirection: 'column',
    gap: '10px',
  },
  editInput: {
    padding: '8px 12px',
    fontSize: '14px',
    border: '2px solid #e0e0e0',
    borderRadius: '6px',
    boxSizing: 'border-box',
